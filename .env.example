# ============================================================================
# Primer okolja — prekopiraj v .env.local in izpolni
# ----------------------------------------------------------------------------
#   cp .env.example .env.local
#
# V tej datoteki ni nobene prave vrednosti in je V GITU. Prava `.env.local`
# ni in nikoli ne sme biti.
#
# Vsaka spremenljivka tu je takšna, ki jo koda res bere. Kar koda neha
# uporabljati, se iz tega primera izbriše — sicer se čez pol leta nihče več ne
# spomni, ali je potrebna.
# ============================================================================

# ── Baza — Supabase (PostgreSQL) ───────────────────────────────────────────
# Oboje najdeš v Supabase → Connect → ORM. Geslo baze po ustvarjanju ni več
# vidno; če ga ni, ga je treba ponastaviti (to prekine obstoječe povezave).
#
#   DATABASE_URL  teče stran — pooler na vratih 6543
#   DIRECT_URL    tečejo migracije in Studio — vrata 5432, brez poolerja
#
# Če ima geslo @ : / ? # &, jih zapiši kot %40 %3A %2F %3F %23 %26.
DATABASE_URL="postgresql://postgres.PROJEKT:GESLO@aws-0-REGIJA.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJEKT:GESLO@aws-0-REGIJA.pooler.supabase.com:5432/postgres"

# ── Seje in prijava v admin ────────────────────────────────────────────────
# SESSION_SECRET je poljuben naključen niz; zgeneriraj ga z:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Ob zamenjavi se odjavijo vse naprave — to je edini način, da jih odjaviš vse.
SESSION_SECRET=""
SESSION_COOKIE_NAME="zm_seja"
SESSION_TTL_DAYS="30"

# ── Pošta — Resend ─────────────────────────────────────────────────────────
# Ključ naj ima SAMO pravico pošiljanja in SAMO za domeno zanmeke.com: če kdaj
# uide, se z njim ne da ne brati ne brisati. Vrednost se v Resendu vidi samo
# enkrat, ob ustvarjanju.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Žan Meke <info@zanmeke.com>"
RESEND_REPLY_TO="info@zanmeke.com"
# Kam pade povpraševanje z obrazca.
CONTACT_TO_EMAIL="info@zanmeke.com"

# ── Shramba — Cloudflare R2 ────────────────────────────────────────────────
# Tu živijo slike strani, računi, predračuni in listine — ne na strežniku, kjer
# teče stran. Skrivni del žetona se v Cloudflaru vidi samo ob ustvarjanju; če
# ga ni, naredi nov žeton (stari se razveljavi, ko ga izbrišeš).
#
# Tri vedra, ista razdelitev kot na drugih dveh straneh:
#   R2_BUCKET            javne slike strani
#   R2_BUCKET_PRIVATE    datoteke, ki jih vidi samo prijavljen
#   R2_BUCKET_DOCUMENTS  računi, predračuni, listine
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://RACUN.r2.cloudflarestorage.com"
R2_BUCKET="zanmeke-slike"
R2_BUCKET_PRIVATE="zanmeke-zasebno"
R2_BUCKET_DOCUMENTS="zanmeke-listine"
# Javni naslov vedra s slikami (prek domene ali r2.dev).
R2_PUBLIC_URL=""

# ── Naslov strani ──────────────────────────────────────────────────────────
# Uporablja ga SEO, slika za deljenje in povezave v pošti. V produkciji mora
# biti prava domena — če tu ostane localhost, bodo take tudi povezave v pošti.
NEXT_PUBLIC_SITE_URL="https://zanmeke.com"

# ── Plačila — Stripe ───────────────────────────────────────────────────────
# Prazno, dokler stran ne sprejema plačil. Testni ključi se v Stripu vidijo
# kadarkoli, živi samo ob ustvarjanju.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
